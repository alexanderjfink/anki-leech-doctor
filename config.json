    "min_lapses": 3,
    "include_suspended": false,
    "include_leeches": true,
    "ease_ceiling": null
  },
  "diagnosis": {
    "wordy_front_threshold": 200,
    "wall_of_text_threshold": 400,
    "support_fields": ["Country info", "Note", "Characteristics", "Back Extra", "Note(s)"]
  },
  "ui": {
    "field_max_height": 260,
    "preview_max_height": 220,
    "rich_edit": false,
    "theme": {
      "mode": "auto",
      "dark": null,
      "accent": "",
      "bg": "",
      "panel": "",
      "fg": "",
      "fg_dim": "",
      "border": ""
    }
  },
  "apply": {
    "confirm_apply_over": 25,
    "keep_revert_log": true
  }
